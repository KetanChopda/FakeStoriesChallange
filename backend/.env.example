# Copy to .env and adjust. Nothing here is a secret.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Catalogue source and cache
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000
CATALOGUE_CACHE_SECONDS=300

# Email: Mailpit locally (see docker-compose in B4); SES SMTP credentials later
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Catalogue <no-reply@example.com>
SALES_INBOX=sales@example.com
